<Window x:Class="ClaudeIpGuard.UI.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClaudeIpGuard.Localization"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" Background="White" FontFamily="Segoe UI"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}"
        Icon="pack://application:,,,/ClaudeIpGuard;component/Assets/app.ico">
    <StackPanel Margin="26,22,26,22">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Border Width="36" Height="36" CornerRadius="18" Background="#EEF2FF" VerticalAlignment="Center">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" FontSize="16" Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="DescriptionText" Style="{StaticResource Sub}" Margin="0,0,0,16"/>

        <TextBlock Text="{loc:T Pwd_Password}" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="Password1" FlowDirection="LeftToRight"/>

        <StackPanel x:Name="ConfirmPanel" Margin="0,12,0,0">
            <TextBlock Text="{loc:T Pwd_Confirm}" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="Password2" FlowDirection="LeftToRight"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="#B91C1C" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="{loc:T Btn_Cancel}" IsCancel="True" MinWidth="96"/>
            <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="{loc:T Btn_OK}" IsDefault="True" MinWidth="96"
                    Margin="10,0,0,0" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
