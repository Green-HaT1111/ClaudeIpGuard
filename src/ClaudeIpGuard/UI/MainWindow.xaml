<Window x:Class="ClaudeIpGuard.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClaudeIpGuard.Localization"
        Title="{loc:T AppTitle}"
        Width="1040" Height="700" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}"
        Icon="pack://application:,,,/ClaudeIpGuard;component/Assets/app.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,26,20,30">
                    <Image Source="pack://application:,,,/ClaudeIpGuard;component/Assets/app.ico" Width="36" Height="36"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Claude IP Guard" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="v1.0" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,22">
                    <TextBlock Text="{loc:T Lang_Label}" Foreground="#94A3B8" FontSize="12" Margin="4,0,0,6"/>
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="LangEn" Style="{StaticResource LangButton}" Content="English" Tag="en" Checked="Lang_Checked"/>
                        <RadioButton x:Name="LangFa" Style="{StaticResource LangButton}" Content="فارسی" Tag="fa" Checked="Lang_Checked"/>
                    </UniformGrid>
                    <Button Style="{StaticResource SidebarExitButton}" Margin="2,16,2,0" Click="Exit_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{loc:T Btn_Exit}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavDashboard" x:FieldModifier="public" Style="{StaticResource NavButton}" Tag="dash" IsChecked="True" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:T Nav_Dashboard}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavActivity" x:FieldModifier="public" Style="{StaticResource NavButton}" Tag="activity" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:T Nav_Activity}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" x:FieldModifier="public" Style="{StaticResource NavButton}" Tag="settings" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:T Nav_Settings}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="{StaticResource WarningBgBrush}" Padding="28,8"
                    Visibility="{Binding TestBannerVisibility}">
                <TextBlock Text="{loc:T TestMode_Banner}" Foreground="{StaticResource WarningTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <Grid Margin="30,26,30,24">

                <!-- Dashboard page -->
                <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{loc:T Dash_Title}" Style="{StaticResource H1}"/>
                        <TextBlock Text="{loc:T Dash_Subtitle}" Style="{StaticResource Sub}" Margin="0,4,0,20"/>

                        <Border CornerRadius="14" Padding="26" Background="{Binding StatusBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="68" Height="68" CornerRadius="34" Background="#33FFFFFF" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="22,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusTitle}" FontSize="24" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding StatusDescription}" FontSize="13.5" Foreground="#EAFFFFFF" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GlassButton}" Click="CheckNow_Click" IsEnabled="{Binding CanCheck}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{loc:T Btn_CheckNow}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GlassButton}" Click="PauseResume_Click" Margin="0,8,0,0" Content="{Binding PauseButtonText}"/>
                                    <Button Style="{StaticResource GlassButton}" Click="Hide_Click" Margin="0,8,0,0" Content="{loc:T Btn_Hide}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding ErrorText}" Visibility="{Binding ErrorVisibility}" Foreground="#B91C1C"
                                   TextWrapping="Wrap" FontSize="12" Margin="4,10,0,0"/>

                        <UniformGrid Columns="3" Margin="0,18,-12,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="{loc:T Info_PublicIp}" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding PublicIp}" Style="{StaticResource Value}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="{loc:T Info_Country}" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding Country}" Style="{StaticResource Value}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="{loc:T Info_City}" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding City}" Style="{StaticResource Value}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="{loc:T Info_Provider}" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding Provider}" Style="{StaticResource Value}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="{loc:T Info_LastCheck}" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding LastCheck}" Style="{StaticResource Value}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="{loc:T Info_NextCheck}" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding NextCheck}" Style="{StaticResource Value}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <UniformGrid Columns="3" Margin="0,0,-12,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="{loc:T Stat_Closed}" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding ClosedCount}" Style="{StaticResource BigNumber}" Foreground="{StaticResource DangerBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="{loc:T Stat_Checks}" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding CheckCount}" Style="{StaticResource BigNumber}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="{loc:T Stat_Allowed}" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding AllowedCount}" Style="{StaticResource BigNumber}" Foreground="{StaticResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Activity page -->
                <Grid x:Name="PageActivity" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,20">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{loc:T Btn_Clear}"
                                Click="ClearActivity_Click" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="{loc:T Activity_Title}" Style="{StaticResource H1}"/>
                            <TextBlock Text="{loc:T Activity_Subtitle}" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                        <Grid>
                            <ListBox ItemsSource="{Binding Activity}" BorderThickness="0" Background="Transparent"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="78"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="9" Height="9" Fill="{Binding LevelBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{loc:T Activity_Empty}" Visibility="{Binding ActivityEmptyVisibility}"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Settings page -->
                <ScrollViewer x:Name="PageSettings" x:FieldModifier="public" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Stretch" DataContext="{Binding Editor}">
                        <TextBlock Text="{loc:T Settings_Title}" Style="{StaticResource H1}"/>
                        <TextBlock Text="{loc:T Settings_Subtitle}" Style="{StaticResource Sub}" Margin="0,4,0,20"/>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{loc:T Set_General}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{loc:T Set_Interval}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left"/>
                                <TextBlock Text="{loc:T Set_IntervalHint}" Style="{StaticResource Sub}" FontSize="12" Margin="0,6,0,16"/>

                                <TextBlock Text="{loc:T Set_Targets}" Style="{StaticResource FieldLabel}"/>
                                <CheckBox IsChecked="{Binding KillDesktop}" Content="{loc:T Set_KillDesktop}"/>
                                <CheckBox IsChecked="{Binding KillCli}" Content="{loc:T Set_KillCli}"/>
                                <CheckBox IsChecked="{Binding FailSafe}" Content="{loc:T Set_FailSafe}" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14" DataContext="{Binding Picker}">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="#EEF2FF" CornerRadius="10" Padding="10,3" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding SelectedSummary}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="{loc:T Set_Countries}" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                </DockPanel>
                                <TextBlock Text="{loc:T Set_CountriesHint}" Style="{StaticResource Sub}" FontSize="12" Margin="0,0,0,12"/>

                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource SecondaryButton}" Content="{loc:T Btn_SelectAll}" Click="SelectAll_Click" Padding="12,6" Margin="8,0,0,0"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="{loc:T Btn_ClearAll}" Click="ClearAll_Click" Padding="12,6" Margin="8,0,0,0"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="{loc:T Btn_ResetEurope}" Click="ResetEurope_Click" Padding="12,6" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <Grid>
                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="30,6,8,6"/>
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="{StaticResource MutedBrush}"
                                                   IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                                        <TextBlock Text="{loc:T Set_Search}" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"
                                                   VerticalAlignment="Center" Margin="32,0,0,0" Visibility="{Binding PlaceholderVisibility}"/>
                                    </Grid>
                                </DockPanel>

                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Height="380">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Regions}" Margin="6">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Visibility" Value="{Binding Visibility}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Expander IsExpanded="{Binding IsExpanded}" Margin="4,3">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <CheckBox IsChecked="{Binding IsChecked}" Margin="0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Margin="6,0,8,0"
                                                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding CountText}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <ItemsControl ItemsSource="{Binding Countries}" Margin="26,4,0,8">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="Visibility" Value="{Binding Visibility}"/>
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <CheckBox IsChecked="{Binding IsSelected}" Width="222" Margin="0,3"
                                                                              ToolTip="{Binding Display}">
                                                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                                                                    </CheckBox>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <TextBlock Text="{Binding SelectedList}" Style="{StaticResource Sub}" FontSize="12" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{loc:T Btn_ChangePassword}"
                                        Click="ChangePassword_Click" VerticalAlignment="Center"/>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="{loc:T Set_Security}" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{loc:T Set_SecurityHint}" Style="{StaticResource Sub}" FontSize="12"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="{Binding Message}" Foreground="{Binding MessageBrush}" Visibility="{Binding MessageVisibility}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Style="{StaticResource PrimaryButton}" Click="Save_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{loc:T Btn_Save}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T Btn_Revert}" Click="Revert_Click" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
