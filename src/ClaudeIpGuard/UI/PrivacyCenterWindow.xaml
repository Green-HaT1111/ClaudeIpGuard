<Window x:Class="ClaudeIpGuard.UI.PrivacyCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Privacy Center" Width="920" Height="720" MinWidth="780" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="HeaderTitle" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock x:Name="HeaderDescription" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="StatusText" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="StatusDetail" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock x:Name="AdapterLabel" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="AdapterBox" Height="30"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock x:Name="ProfileLabel" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ProfileBox" Height="30"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="3" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
            <DockPanel>
                <TextBlock x:Name="FindingsTitle" DockPanel.Dock="Top" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="4,0,0,9"/>
                <ListBox x:Name="FindingsList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,9">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Severity}" FontSize="11" FontWeight="Bold" Foreground="{Binding SeverityBrush}" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Advice}" Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <WrapPanel x:Name="ActionButtons" VerticalAlignment="Center">
                <Button x:Name="ScanButton" Style="{StaticResource SecondaryButton}" Click="Scan_Click" Margin="0,0,7,7"/>
                <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Click="Apply_Click" Margin="0,0,7,7"/>
                <Button x:Name="EnableKillSwitchButton" Style="{StaticResource PrimaryButton}" Click="EnableKillSwitch_Click" Margin="0,0,7,7"/>
                <Button x:Name="RestoreFirewallButton" Style="{StaticResource SecondaryButton}" Click="RestoreFirewall_Click" Margin="0,0,7,7"/>
                <Button x:Name="RestoreLocationButton" Style="{StaticResource SecondaryButton}" Click="RestoreLocation_Click" Margin="0,0,7,7"/>
            </WrapPanel>
            <Button Grid.Column="1" x:Name="CloseButton" Style="{StaticResource SecondaryButton}" Click="Close_Click" VerticalAlignment="Top" Margin="8,0,0,0"/>
        </Grid>
    </Grid>
</Window>
