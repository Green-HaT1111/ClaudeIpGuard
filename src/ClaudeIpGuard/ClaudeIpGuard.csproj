<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClaudeIpGuard</AssemblyName>
    <RootNamespace>ClaudeIpGuard</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <Product>Claude IP Guard</Product>
    <Company>Claude IP Guard</Company>
    <Description>Claude privacy audit and VPN-only network protection for Windows.</Description>
  </PropertyGroup>

  <!-- WPF and WinForms share type names (Application, MessageBox...). Keep WinForms out of the global usings. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- Ship the Windows privacy audit and reversible remediation scripts with the app. -->
  <ItemGroup>
    <Content Include="..\..\tools\*.ps1"
             Link="Tools\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
